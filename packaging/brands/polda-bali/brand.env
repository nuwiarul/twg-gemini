# ==============================================================================
# Profil Branding & Distribusi — POLDA BALI
# Lokasi: packaging/brands/polda-bali/brand.env
# ==============================================================================
# Cara membuat profil Polda lain (misal Polda Jateng):
#   1. Duplikat folder ini menjadi: packaging/brands/polda-jateng/
#   2. Edit brand.env (PUBLIC_SERVER_URL, ORG_NAME, ORG_SUBTITLE, APP_TITLE)
#   3. Ganti logo di packaging/brands/polda-jateng/logos/ (1.png, 2.png, 3.png)
#   4. Jalankan packaging:
#        Windows: .\packaging\windows\package-windows.ps1 -Brand polda-jateng -Version 1.0.0
#        Linux  : bash packaging/linux/package-linux.sh --brand polda-jateng --version 1.0.0
#        macOS  : bash packaging/macos/package-macos.sh --brand polda-jateng --arch universal --version 1.0.0
#
# Catatan Development:
#   Biarkan PUBLIC_SERVER_URL kosong di repo agar mode default saat `cargo run` tetap
#   Lokal (http://127.0.0.1:8010). Saat packaging, isi di sini atau lewat parameter
#   `-PublicServerUrl` / `--public-server-url`.
# ==============================================================================

PUBLIC_SERVER_URL=http://103.179.218.76:8123
ORG_NAME=POLDA BALI
ORG_SUBTITLE=Biro Ops • Bid TIK
APP_TITLE=Tactical Wall Game 3D
